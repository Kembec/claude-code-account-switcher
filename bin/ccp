#!/usr/bin/env python3
"""ccp — switch Claude Code accounts without logging out, live.

MODEL: one live credential + N parking slots.

Claude Code scopes its credential to the config directory. Point CLAUDE_CONFIG_DIR
at a per-slot directory and each account gets a private credential that cannot
clobber the others; leave it unset and every session shares one credential. ccp
parks a credential per slot and exchanges the shared one, which switches the account
for EVERY open session at once, without closing any of them.

A swap ALWAYS parks before it loads: the credential that was live is copied back to
its own slot together with whatever refreshes it accumulated. That way refresh
tokens — which rotate — never diverge between the live store and a slot's store.

INVARIANT: each credential store is read by exactly one family of processes.
    live     <- every plain `claude`
    slot N   <- only `ccp login N` / `ccp pin N`, and only while N is not live
`ccp pin`, `ccp logout` and `ccp rm` refuse to touch the live slot for that reason.

BACKENDS
    macOS            login keychain, via /usr/bin/security   (KeychainStore)
    Linux, Windows   <config dir>/.credentials.json          (FileStore)
Override with CCP_BACKEND=keychain|file — mostly useful for testing.
"""

from __future__ import annotations

import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
import time
import unicodedata
from hashlib import sha256
from pathlib import Path

VERSION = "1.2.0"

HOME = Path.home()
LIVE_DIR = HOME / ".claude"             # config dir every plain `claude` uses
SLOTS = HOME / ".claude-slots"          # slot N lives in SLOTS/N
REG = HOME / ".claude-profiles"         # ccp state
LIVE_STATE = REG / "live"               # which slot number is currently live

WINDOWS = os.name == "nt"

# Per-slot private state: account identity plus ephemeral/per-process files.
# Everything else in the live config dir is shared into each slot as a link.
PRIVATE = {
    ".claude.json", ".credentials.json", "sessions",
    "shell-snapshots", "session-env", "ide", "daemon", "statsig",
    "cache", "paste-cache", "backups", "metrics", "debug", "uploads",
    "history.jsonl", "policy-limits.json", "remote-settings.json",
    "mcp-health-cache.json", "mcp-needs-auth-cache.json",
    ".last-cleanup", ".last-update-result.json",
    "daemon-auth-cooldown", "daemon-auth-status.json", ".storage-write",
}
PRIVATE_SUFFIX = (".log", ".lock")

_COLOR = sys.stdout.isatty() and not os.environ.get("NO_COLOR")
if WINDOWS and _COLOR:
    os.system("")                       # enable ANSI on legacy Windows consoles
C = {"b": "\033[1m", "d": "\033[2m", "g": "\033[32m", "y": "\033[33m",
     "r": "\033[31m", "c": "\033[36m", "0": "\033[0m"}
if not _COLOR:
    C = {k: "" for k in C}


def die(msg: str) -> None:
    print(f"{C['r']}ccp: {msg}{C['0']}", file=sys.stderr)
    raise SystemExit(1)


def short(p: Path) -> str:
    s = str(p)
    return "~" + s[len(str(HOME)):] if s.startswith(str(HOME)) else s


def refuse_sudo() -> None:
    """Refuse to run under sudo, because sudo splits identity in half.

    The config dir comes from HOME, which sudo leaves pointing at the calling user, but
    the keychain account comes from USER, which sudo sets to root. ccp would then look
    for credentials under the wrong account and cheerfully report that a slot has no
    login when it does — or, worse, write one where no session will ever find it. With
    the file backend it would leave root-owned files in your home instead.
    """
    if not os.environ.get("SUDO_USER"):
        return
    die("do not run ccp under sudo.\n"
        f"  sudo sets USER=root while HOME stays {HOME}, so the credential store "
        f"ccp picks would not be the one your sessions read.\n"
        f"  Run it as yourself: ccp {' '.join(sys.argv[1:])}")


# --------------------------------------------------------------------------- #
# credential stores
# --------------------------------------------------------------------------- #

def valid_blob(blob: str | None) -> bool:
    """Never write junk into the live store — it would break every open session."""
    if not blob:
        return False
    try:
        return bool((json.loads(blob).get("claudeAiOauth") or {}).get("accessToken"))
    except ValueError:
        return False


class KeychainStore:
    """macOS login keychain, reached exactly the way Claude Code reaches it.

    Claude Code names the item "Claude Code-credentials" when CLAUDE_CONFIG_DIR is
    unset, and appends "-" plus the first 8 hex chars of the SHA-256 of the
    NFC-normalised config dir path when it is set. Reproducing that derivation is
    what lets ccp park a credential where a Claude Code process will find it.
    """

    kind = "keychain"

    def __init__(self, config_dir: Path | None) -> None:
        if config_dir is None:
            self.service = "Claude Code-credentials"
        else:
            norm = unicodedata.normalize("NFC", str(config_dir))
            self.service = ("Claude Code-credentials-"
                            + sha256(norm.encode()).hexdigest()[:8])

    @staticmethod
    def _account() -> str:
        a = os.environ.get("USER") or "claude-code-user"
        return a if re.fullmatch(r"[a-zA-Z0-9._-]+", a) else "claude-code-user"

    def _run(self, *args: str) -> subprocess.CompletedProcess:
        return subprocess.run(["security", *args], capture_output=True, text=True)

    def read(self) -> str | None:
        r = self._run("find-generic-password", "-a", self._account(), "-w",
                      "-s", self.service)
        out = r.stdout.strip()
        return out if r.returncode == 0 and out else None

    def write(self, blob: str) -> bool:
        # -U updates in place, -X takes a hex payload (what Claude Code does too).
        r = self._run("add-generic-password", "-U", "-a", self._account(),
                      "-s", self.service, "-X", blob.encode().hex())
        return r.returncode == 0

    def delete(self) -> bool:
        r = self._run("delete-generic-password", "-a", self._account(),
                      "-s", self.service)
        return r.returncode == 0

    def describe(self) -> str:
        return self.service


class FileStore:
    """<config dir>/.credentials.json — what Claude Code uses off macOS.

    Writes are atomic (temp file plus replace) so a reader never sees a torn file,
    and the replace bumps the mtime, which is the signal Claude Code watches for to
    notice a credential it did not write itself.
    """

    kind = "file"

    def __init__(self, config_dir: Path) -> None:
        self.path = config_dir / ".credentials.json"

    def read(self) -> str | None:
        try:
            out = self.path.read_text(encoding="utf-8").strip()
        except (OSError, UnicodeDecodeError):
            return None
        return out or None

    def write(self, blob: str) -> bool:
        try:
            self.path.parent.mkdir(parents=True, exist_ok=True)
            fd, tmp = tempfile.mkstemp(dir=str(self.path.parent), prefix=".ccp-cred-")
            try:
                with os.fdopen(fd, "w", encoding="utf-8") as fh:
                    fh.write(blob)
                os.chmod(tmp, 0o600)
                os.replace(tmp, self.path)
            except BaseException:
                os.unlink(tmp)
                raise
            return True
        except OSError:
            return False

    def delete(self) -> bool:
        try:
            self.path.unlink()
            return True
        except OSError:
            return False

    def describe(self) -> str:
        return short(self.path)


def backend() -> str:
    forced = (os.environ.get("CCP_BACKEND") or "").strip().lower()
    if forced in ("keychain", "file"):
        return forced
    if forced:
        die(f"CCP_BACKEND must be 'keychain' or 'file', not {forced!r}")
    return "keychain" if sys.platform == "darwin" else "file"


def store_for(config_dir: Path | None):
    """config_dir None means the live store (the one plain `claude` reads)."""
    if backend() == "keychain":
        return KeychainStore(config_dir)
    return FileStore(LIVE_DIR if config_dir is None else config_dir)


def live_store():
    return store_for(None)


def slot_store(n: int):
    return store_for(slot_dir(n))


def expire_now(blob: str) -> str:
    """Expire the access token without touching the refresh token.

    An access token lasts about eight hours and an open session holds it in memory,
    so it would not re-read the store until that token expired. Backdating
    `expiresAt` makes the process's next token check decide a refresh is due; it
    refreshes with the incoming account's refresh token and thereby adopts that
    identity. Nothing is revoked, so the operation stays reversible.
    """
    d = json.loads(blob)
    d["claudeAiOauth"]["expiresAt"] = int(time.time() * 1000) - 60_000
    return json.dumps(d, separators=(",", ":"))


def copy_cred(src, dst, what: str, nudge: bool = False) -> None:
    blob = src.read()
    if not valid_blob(blob):
        die(f"{what}: source credential is missing or invalid ({src.describe()})")
    payload = expire_now(blob) if nudge else blob
    if not dst.write(payload):
        die(f"{what}: write failed ({dst.describe()})")
    if dst.read() != payload:
        die(f"{what}: read-back verification did not match ({dst.describe()})")


# --------------------------------------------------------------------------- #
# slots
# --------------------------------------------------------------------------- #

def slot_dir(n: int) -> Path:
    return SLOTS / str(n)


def slots() -> list[int]:
    REG.mkdir(parents=True, exist_ok=True)
    ns = []
    for f in REG.glob("slot*.dir"):
        m = re.match(r"^slot(\d+)$", f.stem)
        if m:
            ns.append(int(m.group(1)))
    return sorted(ns)


def live_slot() -> int | None:
    if not LIVE_STATE.is_file():
        return None
    t = LIVE_STATE.read_text().strip()
    return int(t) if t.isdigit() else None


def next_free() -> int:
    used = set(slots())
    n = 1
    while n in used:
        n += 1
    return n


def read_json(p: Path) -> dict:
    try:
        return json.loads(p.read_text(encoding="utf-8"))
    except (OSError, ValueError, UnicodeDecodeError):
        return {}


def account_of(n: int) -> str:
    oa = read_json(slot_dir(n) / ".claude.json").get("oauthAccount") or {}
    email = oa.get("emailAddress") or "-"
    org = oa.get("organizationName")
    return f"{email} ({org})" if org else email


def resolve(token: str) -> int:
    """Accept `2`, `slot2`, or the email (or a prefix) of the slot's account."""
    ns = slots()
    m = re.match(r"^(?:slot)?(\d+)$", token)
    if m:
        n = int(m.group(1))
        if n in ns:
            return n
        die(f"slot{n} does not exist. Create it with `ccp add {n}`.")
    hits = [n for n in ns if account_of(n).split(" ")[0].lower().startswith(token.lower())]
    if len(hits) == 1:
        return hits[0]
    if len(hits) > 1:
        die(f"'{token}' matches several slots: " + ", ".join(f"slot{n}" for n in hits))
    listing = "\n".join(f"    {C['c']}slot{n:<6}{C['0']} {account_of(n)}" for n in ns)
    die(f"'{token}' is neither a slot nor a known account.\n"
        f"  slots:\n{listing}\n  create a new one: ccp add")


# --------------------------------------------------------------------------- #
# identity (.claude.json)
# --------------------------------------------------------------------------- #

ID_KEYS = ("oauthAccount", "userID", "hasAvailableSubscription")


def patch_json(p: Path, updates: dict) -> None:
    """Read-modify-write only `updates`, so unrelated state is preserved."""
    d = read_json(p)
    d.update(updates)
    p.parent.mkdir(parents=True, exist_ok=True)
    p.write_text(json.dumps(d, indent=2, ensure_ascii=False) + "\n", encoding="utf-8")


def park_identity(n: int) -> None:
    live = read_json(HOME / ".claude.json")
    patch_json(slot_dir(n) / ".claude.json", {k: live[k] for k in ID_KEYS if k in live})


def load_identity(n: int) -> None:
    parked = read_json(slot_dir(n) / ".claude.json")
    if any(k in parked for k in ID_KEYS):
        patch_json(HOME / ".claude.json", {k: parked[k] for k in ID_KEYS if k in parked})


# --------------------------------------------------------------------------- #
# shared links
# --------------------------------------------------------------------------- #

def is_private(name: str) -> bool:
    return name in PRIVATE or name.endswith(PRIVATE_SUFFIX)


def link_target(dst: Path) -> str | None:
    """Where dst points, for symlinks and for Windows directory junctions."""
    try:
        if dst.is_symlink():
            return os.readlink(dst)
    except OSError:
        return None
    if WINDOWS and dst.is_dir():
        try:
            # A junction is a reparse point; realpath resolves it, unlike a plain dir.
            real = os.path.realpath(dst)
            return real if real != str(dst) else None
        except OSError:
            return None
    return None


def make_link(src: Path, dst: Path) -> str:
    """Link dst -> src. Returns the strategy used, or raises OSError.

    Symlinks on Windows need Developer Mode or elevation, so fall back to what does
    not: directory junctions (mklink /J) and file hardlinks.
    """
    try:
        os.symlink(src, dst, target_is_directory=src.is_dir())
        return "symlink"
    except (OSError, NotImplementedError):
        if not WINDOWS:
            raise
    if src.is_dir():
        r = subprocess.run(["cmd", "/c", "mklink", "/J", str(dst), str(src)],
                           capture_output=True, text=True)
        if r.returncode == 0:
            return "junction"
        raise OSError(r.stderr.strip() or "mklink /J failed")
    os.link(src, dst)                   # hardlink: no privilege needed on NTFS
    return "hardlink"


def unlink_any(dst: Path) -> None:
    if dst.is_symlink() or dst.is_file():
        dst.unlink()
    elif dst.is_dir():
        dst.rmdir()                     # a junction removes like an empty dir


def sync(n: int, quiet: bool = False) -> None:
    """Link everything shareable from the live config dir into the slot. Idempotent."""
    d = slot_dir(n)
    d.mkdir(parents=True, exist_ok=True)
    ok = new = skipped = failed = 0
    how: set[str] = set()
    for src in sorted(LIVE_DIR.iterdir()):
        if is_private(src.name):
            continue
        dst = d / src.name
        current = link_target(dst)
        if current is not None:
            if os.path.normcase(current) == os.path.normcase(str(src)):
                ok += 1
                continue
            unlink_any(dst)
        elif dst.exists():
            skipped += 1                # real content in the slot: never overwritten
            continue
        try:
            how.add(make_link(src, dst))
            new += 1
        except OSError:
            failed += 1
    if not quiet:
        msg = f"{C['d']}sync slot{n}: {ok} ok, {new} (re)linked"
        if how:
            msg += f" ({'/'.join(sorted(how))})"
        if skipped:
            msg += f", {skipped} slot-owned"
        print(msg + C["0"])
    if failed:
        print(f"{C['y']}  ! {failed} item(s) could not be linked into slot{n}. "
              f"The slot still works, it just will not share those.{C['0']}")
        if WINDOWS:
            print(f"{C['d']}    On Windows, enabling Developer Mode allows symlinks "
                  f"and makes this exact.{C['0']}")


def seed(n: int) -> None:
    """Copy UI prefs and MCP servers so a new slot skips the onboarding wizard."""
    d = slot_dir(n)
    cur = read_json(d / ".claude.json")
    src = read_json(HOME / ".claude.json")
    for k in ("theme", "editorMode", "autoUpdates", "installMethod", "autoConnectIde",
              "respectGitignore", "mcpServers", "shiftEnterKeyBindingInstalled",
              "deepLinkTerminal"):
        if k in src:
            cur.setdefault(k, src[k])
    cur.setdefault("hasCompletedOnboarding", True)
    (d / ".claude.json").write_text(
        json.dumps(cur, indent=2, ensure_ascii=False) + "\n", encoding="utf-8")


def slot_env(n: int) -> dict[str, str]:
    env = dict(os.environ)
    env["CLAUDE_CONFIG_DIR"] = str(slot_dir(n))
    return env


def history():
    """bin/ccp_history.py, installed next to this script (symlinks resolved)."""
    sys.path.insert(0, str(Path(__file__).resolve().parent))
    import ccp_history
    return ccp_history


def run_claude(argv: list[str], env: dict[str, str], replace: bool = False) -> int:
    """Run claude. Replacing the process is nicer, but Windows has no real exec."""
    exe = shutil.which("claude")
    if not exe:
        die("`claude` is not on PATH")
    if replace and not WINDOWS:
        os.execve(exe, [exe, *argv], env)
    return subprocess.run([exe, *argv], env=env).returncode


# --------------------------------------------------------------------------- #
# commands
# --------------------------------------------------------------------------- #

def cmd_ls(_a: list[str]) -> None:
    ns = slots()
    if not ns:
        print("No slots yet. Run: ccp init")
        return
    lv = live_slot()
    print(f"{C['b']}  {'SLOT':<7} {'ACCOUNT':<36} {'CREDENTIAL':<11} STATE{C['0']}")
    for n in ns:
        parked = valid_blob(slot_store(n).read())
        if n == lv:
            state = f"{C['g']}LIVE{C['0']} {C['d']}- every session uses this{C['0']}"
            cred = f"{C['g']}live{C['0']}       "
        else:
            state = f"{C['d']}parked{C['0']}" if parked else f"{C['y']}no login yet{C['0']}"
            cred = f"{C['d']}parked{C['0']}     " if parked else f"{C['y']}-{C['0']}          "
        mark = f"{C['g']}>{C['0']}" if n == lv else " "
        print(f"{mark} {C['c']}slot{n:<3}{C['0']} {account_of(n):<36} {cred} {state}")
    print(f"\n{C['d']}`ccp swap <n>` switches the account for EVERY open session · "
          f"`ccp add` creates slot{next_free()}{C['0']}")


def cmd_swap(args: list[str]) -> None:
    pos = [a for a in args if not a.startswith("-")]
    if not pos:
        die("usage: ccp swap <n> [--lazy]")
    n = resolve(pos[0])
    lv = live_slot()
    if n == lv:
        print(f"slot{n} is already live ({account_of(n)}) - nothing to do")
        return
    if not valid_blob(slot_store(n).read()):
        die(f"slot{n} has no parked credential -> ccp login {n}")

    # 1) park the live credential back into its own slot, refreshes included
    if lv is not None:
        copy_cred(live_store(), slot_store(lv), f"parking slot{lv}")
        park_identity(lv)
        print(f"{C['d']}  v slot{lv} parked ({account_of(lv)}){C['0']}")
    else:
        print(f"{C['y']}  ! no live slot was registered; the previous live credential "
              f"was not parked{C['0']}")

    # 2) load the target slot as live
    nudge = "--lazy" not in args
    copy_cred(slot_store(n), live_store(), f"loading slot{n}", nudge=nudge)
    load_identity(n)
    LIVE_STATE.write_text(f"{n}\n")

    print(f"{C['g']}OK{C['0']} live is now {C['b']}slot{n}{C['0']} · {account_of(n)}")
    if nudge:
        print(f"{C['d']}  access token deliberately expired -> open sessions refresh "
              f"into this account on their next token check. Close nothing.{C['0']}")
    else:
        print(f"{C['d']}  --lazy: open sessions stay on the previous account until "
              f"their token expires (up to ~8 h){C['0']}")


def cmd_add(args: list[str]) -> None:
    nums = [a for a in args if a.isdigit()]
    n = int(nums[0]) if nums else next_free()
    if n < 1:
        die("slot numbers start at 1")
    if n in slots():
        die(f"slot{n} already exists -> {short(slot_dir(n))}")
    slot_dir(n).mkdir(parents=True, exist_ok=True)
    REG.mkdir(parents=True, exist_ok=True)
    (REG / f"slot{n}.dir").write_text(str(slot_dir(n)) + "\n")
    if "--no-seed" not in args:
        seed(n)
    sync(n)
    print(f"{C['g']}OK{C['0']} {C['b']}slot{n}{C['0']} created at {short(slot_dir(n))}")
    print(f"  credential store: {C['d']}{slot_store(n).describe()}{C['0']}")
    if valid_blob(slot_store(n).read()):
        print(f"  {C['g']}a parked credential was already there{C['0']} -> {account_of(n)}")
    else:
        print(f"  next: {C['c']}ccp login {n}{C['0']}")


def cmd_logout(args: list[str]) -> None:
    if not args:
        die("usage: ccp logout <n>")
    n = resolve(args[0])
    if n == live_slot():
        die(f"slot{n} is live. Swap to another slot first (`ccp swap <m>`), then log "
            f"this one out.")
    if not valid_blob(slot_store(n).read()):
        print(f"slot{n} has no parked credential")
        return
    if not slot_store(n).delete():
        die(f"could not delete slot{n}'s credential")
    print(f"{C['g']}OK{C['0']} slot{n} logged out {C['d']}(config dir untouched){C['0']}")


def cmd_pin(args: list[str]) -> None:
    """Run a claude nailed to one slot, immune to swaps."""
    if not args:
        die("usage: ccp pin <n> [claude args...]")
    n = resolve(args[0])
    if n == live_slot():
        die(f"slot{n} is live: just use plain `claude`, which is already that account.\n"
            f"  (pinning a process to the live slot would make refresh tokens diverge)")
    if not valid_blob(slot_store(n).read()):
        die(f"slot{n} has no parked credential -> ccp login {n}")
    rest = [a for a in args[1:] if a != "--"]
    sync(n, quiet=True)
    raise SystemExit(run_claude(rest, slot_env(n), replace=True))


def cmd_sync(args: list[str]) -> None:
    for n in ([resolve(args[0])] if args else slots()):
        sync(n)
    print(f"{C['g']}OK{C['0']} shared links up to date")


def cmd_live(_a: list[str]) -> None:
    lv = live_slot()
    print("(none)" if lv is None else f"slot{lv}\t{account_of(lv)}")


def cmd_rm(args: list[str]) -> None:
    if not args:
        die("usage: ccp rm <n> [--purge]")
    n = resolve(args[0])
    if n == live_slot():
        die(f"slot{n} is live. Swap to another slot before removing it.")
    (REG / f"slot{n}.dir").unlink(missing_ok=True)
    if "--purge" in args:
        slot_store(n).delete()
        shutil.rmtree(slot_dir(n), ignore_errors=True)
        print(f"{C['g']}OK{C['0']} slot{n} removed: registration, dir and credential")
    else:
        print(f"{C['g']}OK{C['0']} slot{n} unregistered "
              f"{C['d']}(dir and credential kept; `ccp add {n}` restores it){C['0']}")


def cmd_init(_a: list[str]) -> None:
    """Park the credential you are logged in with into slot1 and mark it live."""
    if not slots():
        n = 1
        slot_dir(n).mkdir(parents=True, exist_ok=True)
        REG.mkdir(parents=True, exist_ok=True)
        (REG / f"slot{n}.dir").write_text(str(slot_dir(n)) + "\n")
        seed(n)
        sync(n, quiet=True)
    if live_slot() is None:
        if not valid_blob(live_store().read()):
            die("no live credential found - run `claude` and /login first")
        n = 1 if 1 in slots() else slots()[0]
        copy_cred(live_store(), slot_store(n),
                  f"parking the live credential in slot{n}")
        live_id = read_json(HOME / ".claude.json")
        patch_json(slot_dir(n) / ".claude.json",
                   {k: live_id[k] for k in ID_KEYS if k in live_id})
        LIVE_STATE.write_text(f"{n}\n")
        print(f"{C['g']}OK{C['0']} live credential parked in slot{n} "
              f"({account_of(n)}) and marked live")
    cmd_ls([])


def cmd_doctor(_a: list[str]) -> None:
    """Self-check. ccp rides on undocumented internals; this says whether they hold."""
    ok = True

    def line(good: bool, label: str, detail: str = "") -> None:
        nonlocal ok
        ok = ok and good
        icon = f"{C['g']}OK{C['0']}" if good else f"{C['r']}!!{C['0']}"
        print(f"  {icon} {label}" + (f" {C['d']}{detail}{C['0']}" if detail else ""))

    print(f"{C['b']}ccp {VERSION} doctor{C['0']}")
    print(f"  {C['d']}platform {sys.platform}, backend {backend()}, "
          f"python {sys.version.split()[0]}{C['0']}")

    claude = shutil.which("claude")
    if claude:
        v = subprocess.run([claude, "--version"], capture_output=True, text=True)
        line(True, "claude on PATH", v.stdout.strip() or claude)
    else:
        line(False, "claude on PATH", "not found")

    if backend() == "keychain":
        r = subprocess.run(["security", "list-keychains"], capture_output=True)
        acct = KeychainStore._account()
        line(r.returncode == 0, "login keychain reachable", f"account {acct}")
        if acct != HOME.name:
            print(f"    {C['y']}! keychain account '{acct}' does not match the home "
                  f"directory '{HOME.name}' - credentials may be looked up in the "
                  f"wrong place{C['0']}")
    else:
        line(LIVE_DIR.is_dir(), "live config dir exists", short(LIVE_DIR))

    live_blob = live_store().read()
    line(valid_blob(live_blob), "live credential present", live_store().describe())
    if valid_blob(live_blob):
        exp = (json.loads(live_blob)["claudeAiOauth"].get("expiresAt") or 0) / 1000
        print(f"    {C['d']}access token expires in "
              f"{(exp - time.time()) / 3600:+.2f} h{C['0']}")

    ns = slots()
    line(bool(ns), "slots registered", ", ".join(f"slot{n}" for n in ns) or "none")

    lv = live_slot()
    line(lv in ns if ns else False, "live slot recorded",
         f"slot{lv}" if lv else "missing - run `ccp init`")

    for n in ns:
        d = slot_dir(n)
        parked = valid_blob(slot_store(n).read())
        links = (sum(1 for x in d.iterdir() if link_target(x) is not None)
                 if d.is_dir() else 0)
        state = "live" if n == lv else ("parked" if parked else "no credential")
        print(f"    {C['d']}slot{n}: {state}, {links} shared links, "
              f"{slot_store(n).describe()}{C['0']}")

    print(f"\n{'all good' if ok else C['y'] + 'problems above' + C['0']}")
    raise SystemExit(0 if ok else 1)


HELP = f"""{C['b']}ccp {VERSION}{C['0']} - switch Claude Code accounts without closing a session

  {C['c']}ccp ls{C['0']}                slots, the account in each, which one is live
  {C['c']}ccp swap{C['0']} <n>          {C['b']}switch the account for EVERY open session{C['0']}
  {C['c']}ccp add{C['0']} [n]           create a slot (no n: first free number)
  {C['c']}ccp login{C['0']} <n>         run /login in that slot and park its credential
  {C['c']}ccp logout{C['0']} <n>        delete a slot's parked credential
  {C['c']}ccp history{C['0']} <n>       accounts the slot held before  [--json]
  {C['c']}ccp use{C['0']} <n> <acc>     put a past account back in slot n; the current one
                        moves to its history (not on the live slot)  [--json]
  {C['c']}ccp pin{C['0']} <n> ...       run a claude nailed to one slot, immune to swaps
  {C['c']}ccp live{C['0']}              which slot is live right now
  {C['c']}ccp sync{C['0']} [n]          rebuild the shared links (idempotent)
  {C['c']}ccp rm{C['0']} <n>            unregister a slot  [--purge deletes dir + credential]
  {C['c']}ccp doctor{C['0']}            self-check the environment and state
  {C['c']}ccp init{C['0']}              park your current login into slot1

{C['d']}<n> accepts `2`, `slot2`, or the account's email.

How it works: every plain `claude` shares one credential store. `ccp swap` exchanges
its contents, so the account changes for all live sessions without closing anything.
It always parks the outgoing credential first, so rotating refresh tokens never
diverge. `ccp pin` is the opposite: a process nailed to one slot that swaps ignore.

Backend: macOS login keychain; .credentials.json on Linux and Windows.
Never run ccp with sudo: it would use root's credential store, not yours.
Not affiliated with Anthropic. Use only with accounts you own.{C['0']}"""


CMDS = {
    "ls": cmd_ls, "list": cmd_ls,
    "swap": cmd_swap, "switch": cmd_swap,
    "use": lambda a: history().cmd_use(sys.modules[__name__], a),
    "add": cmd_add, "new": cmd_add,
    "login": lambda a: history().cmd_login(sys.modules[__name__], a),
    "logout": cmd_logout,
    "history": lambda a: history().cmd_history(sys.modules[__name__], a),
    "restore": lambda a: history().cmd_restore(sys.modules[__name__], a),
    "pin": cmd_pin, "run": cmd_pin,
    "live": cmd_live, "active": cmd_live, "current": cmd_live,
    "sync": cmd_sync, "rm": cmd_rm, "remove": cmd_rm,
    "init": cmd_init, "doctor": cmd_doctor,
}


def main() -> None:
    argv = sys.argv[1:]
    if not argv or argv[0] in ("-h", "--help", "help"):
        print(HELP)
        return
    if argv[0] in ("-V", "--version", "version"):
        print(f"ccp {VERSION}")
        return
    fn = CMDS.get(argv[0])
    if not fn:
        die(f"unknown command '{argv[0]}' - try `ccp --help`")
    refuse_sudo()
    fn(argv[1:])


if __name__ == "__main__":
    main()
